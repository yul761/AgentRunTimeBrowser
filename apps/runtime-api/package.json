{
  "name": "@arb/runtime-api",
  "version": "0.1.0",
  "private": true,
  "description": "Optional runtime inspection API for Agentability Audit probes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx --conditions=development src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arb/browser-driver": "workspace:*",
    "@arb/core": "workspace:*",
    "@arb/task-engine": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0"
  }
}
