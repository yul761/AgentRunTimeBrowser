{
  "name": "@arb/audit",
  "version": "0.1.0",
  "private": true,
  "description": "Agentability scoring, issue generation, and deterministic task probes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arb/browser-driver": "workspace:*",
    "@arb/core": "workspace:*",
    "@arb/schemas": "workspace:*"
  }
}
