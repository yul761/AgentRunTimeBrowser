{
  "name": "agentability-audit",
  "description": "Local-first Agentability Audit toolkit with a structured browser runtime engine.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "arb": "tsx --conditions=development packages/cli/src/index.ts",
    "baseline": "tsx baseline/benchmark.ts",
    "compare": "tsx --tsconfig tsconfig.base.json --conditions=development baseline/compare.ts",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @arb/runtime-api dev",
    "dev:ui": "pnpm --filter @arb/monitor-ui dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:baseline",
    "typecheck:baseline": "tsc -p baseline/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "happy-dom": "^15.11.7",
    "playwright": "^1.49.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
